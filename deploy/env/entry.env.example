# Copy to /etc/khaymali/entry.env and chmod 600
KHAYMALI_KEY=REPLACE_WITH_64_HEX_PRIVATE_KEY
KHAYMALI_EXIT_PUB=REPLACE_WITH_64_HEX_EXIT_PUBLIC_KEY
KHAYMALI_EXIT=203.0.113.10:4440
KHAYMALI_SOCKS=127.0.0.1:1080
KHAYMALI_POOL=16
KHAYMALI_METRICS=127.0.0.1:9109

# Optional Intelligence & NLP controls (safe shadow defaults)
KHAYMALI_NLP_MODE=shadow
KHAYMALI_NLP_ONLINE_LEARNING=0
KHAYMALI_PATH_INTEL=shadow
# KHAYMALI_NLP_MODEL_PATH=/var/lib/khaymali/nlp.model
# KHAYMALI_NLP_CANDIDATE_PATH=/var/lib/khaymali/nlp-candidate.model
# KHAYMALI_RISK_CALIBRATOR_PATH=/var/lib/khaymali/risk.model
