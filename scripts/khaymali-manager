#!/usr/bin/env bash
# khaymali-manager — interactive setup & management menu (matches docs/INSTALL.md)
set -uo pipefail
VERSION_MGR="0.15.1"
REPO="${KHAYMALI_REPO:-DevSorena/khaymali}"
BIN="${KHAYMALI_BIN:-/usr/local/bin/khaymali}"
ETC=/etc/khaymali
UNIT=/etc/systemd/system
BK=/var/backups/khaymali

c_g=$'\e[32m'; c_r=$'\e[31m'; c_y=$'\e[33m'; c_b=$'\e[1m'; c_0=$'\e[0m'
ok(){ echo "${c_g}[ok]${c_0} $*"; }
warn(){ echo "${c_y}[!]${c_0} $*"; }
err(){ echo "${c_r}[x]${c_0} $*" >&2; }
pause(){ [ -t 0 ] && read -rp "Press Enter..." _ ; }
ask(){ local p="$1" d="${2:-}" v; read -rp "$p${d:+ [$d]}: " v; echo "${v:-$d}"; }
need_root(){ [ "$(id -u)" = 0 ] || { err "run as root"; exit 1; }; }
has_role(){ [ -f "$ETC/$1.conf" ]; }
roles(){ for r in exit entry bridge; do has_role $r && echo $r; done; }
metrics_port(){ case $1 in exit) echo 9110;; entry) echo 9109;; bridge) echo 9111;; esac; }

keypair(){ # prints "PRIV PUB"
  local o; o=$("$BIN" keygen)
  echo "$(awk '/^private:/{print $2}' <<<"$o") $(awk '/^public:/{print $2}' <<<"$o")"
}
myip(){ curl -4 -s -m 6 ifconfig.me 2>/dev/null || hostname -I | awk '{print $1}'; }
conf_get(){ grep -E "^$2=" "$ETC/$1.conf" 2>/dev/null | head -1 | cut -d= -f2-; }
conf_set(){ local f="$ETC/$1.conf"; touch "$f"; if grep -qE "^$2=" "$f"; then sed -i "s|^$2=.*|$2=$3|" "$f"; else echo "$2=$3" >>"$f"; fi; }
join_decode(){ # $1 code -> sets J_ep J_pk J_sni J_sec
  local body="${1#khaymali://v1?}"; J_ep=; J_pk=; J_sni=; J_sec=
  [ "$body" = "$1" ] && { err "invalid join code"; return 1; }
  IFS='&' read -ra kv <<<"$body"
  for p in "${kv[@]}"; do case "${p%%=*}" in ep) J_ep=${p#*=};; pk) J_pk=${p#*=};; sni) J_sni=${p#*=};; sec) J_sec=${p#*=};; esac; done
  [ -n "$J_ep" ] && [ -n "$J_pk" ] || { err "join code missing ep/pk"; return 1; }
}

# ---------- systemd unit generation (from /etc/khaymali/<role>.conf) ----------
write_unit(){
  local role=$1 args=""
  # shellcheck disable=SC1090
  set -a; . "$ETC/$role.conf"; set +a
  local mp; mp=$(metrics_port "$role")
  case $role in
    exit)
      args="exit --listen ${LISTEN}"
      for k in ${ALLOW:-}; do args+=" --allow $k"; done
      args+=" --camo-secret ${CAMO} --camo-fallback ${FALLBACK}"
      [ -n "${REVERSE_ENTRY:-}" ] && args+=" --reverse-entry ${REVERSE_ENTRY}" ;;
    entry)
      args="entry --exit-pub ${EXIT_PUB} --socks ${SOCKS}"
      if [ "${MODE:-direct}" = bridge ]; then
        args+=" --bridge-listen ${BRIDGE_LISTEN}"
        for k in ${ALLOW_BRIDGE:-}; do args+=" --allow-bridge $k"; done
      else
        args+=" --exit ${EXIT} --camo-secret ${CAMO} --camo-sni ${SNI}"
      fi
      [ -n "${FORWARDS:-}" ] && args+=" --forward ${FORWARDS}" ;;
    bridge)
      args="bridge --entry ${ENTRY} --entry-pub ${ENTRY_PUB} --exit ${EXIT} --camo-secret ${CAMO} --camo-sni ${SNI}" ;;
  esac
  args+=" --metrics 127.0.0.1:$mp --control /run/khaymali/$role.sock"
  cat >"$UNIT/khaymali-$role.service" <<EOF
[Unit]
Description=Khaymali $role (managed by khaymali-manager)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=$ETC/$role.env
ExecStart=$BIN $args
RuntimeDirectory=khaymali
StateDirectory=khaymali
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
}
apply_role(){ # validate + restart with rollback
  local role=$1; local bak="$UNIT/khaymali-$role.service.prev"
  [ -f "$UNIT/khaymali-$role.service" ] && cp "$UNIT/khaymali-$role.service" "$bak"
  write_unit "$role"
  systemctl enable khaymali-$role >/dev/null 2>&1
  systemctl restart khaymali-$role; sleep 4
  if systemctl is-active -q khaymali-$role; then ok "khaymali-$role is running"; rm -f "$bak"
  else
    err "khaymali-$role failed to start:"; journalctl -u khaymali-$role -n 12 --no-pager -o cat
    if [ -f "$bak" ]; then warn "rolling back to previous unit"; mv "$bak" "$UNIT/khaymali-$role.service"; systemctl daemon-reload; systemctl restart khaymali-$role; fi
    return 1
  fi
}
save_env(){ umask 077; printf 'KHAYMALI_KEY=%s\nKHAYMALI_NLP_MODE=%s\n' "$2" "${3:-shadow}" >"$ETC/$1.env"; chmod 600 "$ETC/$1.env"; }

# ---------- 1. EXIT ----------
setup_exit(){
  mkdir -p "$ETC"
  local port fb ip priv pub camo
  port=$(ask "Listen port" 443); fb=$(ask "Camouflage fallback site" www.microsoft.com:443)
  ip=$(ask "Public IP of this server" "$(myip)")
  read -r priv pub < <(keypair); camo=$("$BIN" secret | tail -1)
  save_env exit "$priv"
  : >"$ETC/exit.conf"
  conf_set exit LISTEN "0.0.0.0:$port"; conf_set exit FALLBACK "$fb"; conf_set exit CAMO "$camo"
  conf_set exit PUBLIC_IP "$ip"; conf_set exit PUB "$pub"
  local sni=${fb%%:*}
  conf_set exit JOIN "\"khaymali://v1?ep=$ip:$port&pk=$pub&sni=$sni&sec=$camo\""
  command -v ufw >/dev/null && ufw allow "$port/tcp" >/dev/null 2>&1
  warn "No Entry key allowed yet: the Exit starts after you add one (menu 8)."
  echo; echo "${c_b}Exit public key:${c_0} $pub"
  echo "${c_b}Exit join code (secret! copy to the Entry server):${c_0}"
  echo "  $(conf_get exit JOIN | tr -d '"')"
  echo; echo "Next: on the Iran/Entry server run khaymali-manager -> 2, paste this code."
}

# ---------- 2. ENTRY ----------
setup_entry(){
  mkdir -p "$ETC"
  local code mode priv pub
  code=$(ask "Paste Exit join code"); join_decode "$code" || return 1
  mode=$(ask "Mode: direct (Entry->Exit) or bridge (Entry<-Bridge->Exit)" direct)
  read -r priv pub < <(keypair); save_env entry "$priv"
  : >"$ETC/entry.conf"
  conf_set entry MODE "$mode"; conf_set entry EXIT_PUB "$J_pk"; conf_set entry EXIT "$J_ep"
  conf_set entry CAMO "$J_sec"; conf_set entry SNI "${J_sni:-www.microsoft.com}"
  conf_set entry SOCKS "$(ask 'SOCKS listen' 127.0.0.1:1080)"; conf_set entry PUB "$pub"
  if [ "$mode" = bridge ]; then
    local bp ip; bp=$(ask "Port the Bridge connects to (on this server)" 4443); ip=$(ask "Public IP of this server" "$(myip)")
    conf_set entry BRIDGE_LISTEN "0.0.0.0:$bp"
    command -v ufw >/dev/null && ufw allow "$bp/tcp" >/dev/null 2>&1
    echo "${c_b}Bridge join code (secret!):${c_0}"
    echo "  khaymali://v1?ep=$ip:$bp&pk=$pub&x=$J_ep&xpk=$J_pk&sni=${J_sni}&sec=$J_sec"
    warn "Entry starts after you add the Bridge public key (menu 8)."
  else
    apply_role entry
  fi
  echo; echo "${c_b}Entry public key (add it on the Exit, menu 8):${c_0} $pub"
}

# ---------- 3. BRIDGE ----------
setup_bridge(){
  mkdir -p "$ETC"
  local code priv pub x xpk; code=$(ask "Paste Bridge join code"); join_decode "$code" || return 1
  x=$(sed -n 's/.*[?&]x=\([^&]*\).*/\1/p' <<<"$code"); xpk=$(sed -n 's/.*[?&]xpk=\([^&]*\).*/\1/p' <<<"$code")
  read -r priv pub < <(keypair); save_env bridge "$priv"
  : >"$ETC/bridge.conf"
  conf_set bridge ENTRY "$J_ep"; conf_set bridge ENTRY_PUB "$J_pk"; conf_set bridge EXIT "$x"
  conf_set bridge EXIT_PUB "$xpk"; conf_set bridge CAMO "$J_sec"; conf_set bridge SNI "${J_sni:-www.microsoft.com}"; conf_set bridge PUB "$pub"
  apply_role bridge
  echo "${c_b}Bridge public key (add it on the Entry, menu 8; and on the Exit as allowed key):${c_0} $pub"
}

# ---------- 4. STATUS ----------
m(){ grep -E "^khaymali_$2 " <<<"$1" | awk '{print $2}' | head -1; }
status(){
  local any=0
  for r in $(roles); do
    any=1; local M; M=$(curl -s -m 3 "127.0.0.1:$(metrics_port $r)/metrics")
    echo "${c_b}=== $r ===${c_0}  service: $(systemctl is-active khaymali-$r 2>/dev/null)   pubkey: $(conf_get $r PUB | cut -c1-16)…"
    [ -z "$M" ] && { warn "metrics not reachable"; continue; }
    printf "  links_ready %-6s streams %s active / %s total   link_fails %s\n" "$(m "$M" links_ready)" "$(m "$M" streams_active)" "$(m "$M" streams_total)" "$(m "$M" link_failures_total)"
    local dn up; dn=$(m "$M" bytes_down_total); up=$(m "$M" bytes_up_total); dn=${dn%.*}; up=${up%.*}
    printf "  traffic down %s MB / up %s MB   rtt %s ms   loss %s‰\n" "$(( ${dn:-0} / 1048576 ))" "$(( ${up:-0} / 1048576 ))" "$(m "$M" nlp_link_rtt_ms)" "$(m "$M" nlp_link_loss_per_mille)" 2>/dev/null
    local it; it=$(m "$M" nlp_last_intent)
    local names=(healthy early_rst byte_freeze pmtu_drop throttle route_or_dns_fail unrelated)
    printf "  nlp intent %s   nlp actions %s   reverts %s   camo accepted %s fallback %s\n" "${names[${it:-0}]:-?}" "$(m "$M" nlp_actions_total)" "$(m "$M" nlp_reverts_total)" "$(m "$M" camo_accepted_total)" "$(m "$M" camo_fallback_total)"
    if [ $r = entry ]; then echo "  exit ip via tunnel: $(curl -s -m 8 --socks5-hostname "$(conf_get entry SOCKS)" https://ifconfig.me)"; fi
  done
  [ $any = 0 ] && warn "no role configured on this server (use 1, 2 or 3)"
}

# ---------- 8. KEYS ----------
manage_keys(){
  local r; r=$(roles | head -1); [ -z "$r" ] && { warn "set up a role first"; return; }
  [ "$(roles | wc -l)" -gt 1 ] && r=$(ask "Role" "$r")
  local var; case $r in exit) var=ALLOW;; entry) var=ALLOW_BRIDGE;; *) warn "bridge has no allow-list"; return;; esac
  echo "Allowed keys for $r:"; local i=1; for k in $(conf_get $r $var | tr -d '"'); do echo "  $i) $k"; i=$((i+1)); done
  echo "  a) add   d) delete   s) show my public key / join code   b) back"
  case $(ask "Choice" b) in
    a) local k; k=$(ask "Public key (64 hex)"); [[ "$k" =~ ^[0-9a-f]{64}$ ]] || { err "invalid key"; return; }
       conf_set $r $var "\"$(conf_get $r $var | tr -d '"') $k\""; apply_role $r ;;
    d) local n; n=$(ask "Number"); local new; new=$(conf_get $r $var | tr -d '"' | tr ' ' '\n' | sed '/^$/d' | sed "${n}d" | xargs)
       conf_set $r $var "\"$new\""; apply_role $r ;;
    s) echo "public: $(conf_get $r PUB)"; [ $r = exit ] && echo "join:   $(conf_get exit JOIN | tr -d '"')" ;;
  esac
}

# ---------- 9. DOCTOR ----------
doctor(){
  local host=${1:-} port=${2:-443}
  [ -z "$host" ] && { host=$(ask "Exit IP"); port=$(ask "Port" 443); }
  echo "--- host ---"; "$BIN" doctor 2>&1 | tail -5
  echo "--- path to $host:$port ---"
  local okc=0; for i in 1 2 3 4 5; do timeout 4 bash -c "echo > /dev/tcp/$host/$port" 2>/dev/null && okc=$((okc+1)); done
  echo "TCP connects: $okc/5"
  getent hosts www.google.com >/dev/null && echo "DNS: ok" || warn "DNS: broken (try menu 13 or fix /etc/resolv.conf)"
  ping -c3 -W2 "$host" 2>/dev/null | tail -1
  if [ $okc -ge 4 ]; then ok "Verdict: DIRECT mode should work"; elif [ $okc -ge 1 ]; then warn "Verdict: unstable path, try another port or BRIDGE"; else err "Verdict: blocked -> use BRIDGE mode (or another port/IP)"; fi
}

# ---------- 10. FORWARDS ----------
forwards(){
  has_role entry || { warn "forwards live on the Entry server"; return; }
  echo "Current: $(conf_get entry FORWARDS)"
  local f; f=$(ask "Ports to forward to the Exit side, comma separated (empty = none)" "$(conf_get entry FORWARDS)")
  for p in ${f//,/ }; do [ "$p" = "$(conf_get entry SOCKS | cut -d: -f2)" ] && { err "loop: $p is the SOCKS port"; return; }; done
  conf_set entry FORWARDS "$f"; apply_role entry
}

# ---------- 11/12/13/15/16/17 ----------
edit_cfg(){ local r; r=$(ask "Role" "$(roles | head -1)"); ${EDITOR:-nano} "$ETC/$r.conf"; apply_role "$r"; }
timers(){
  local r h; r=$(ask "Role" "$(roles | head -1)"); h=$(ask "Daily restart hour (empty = disable)" 4)
  if [ -z "$h" ]; then systemctl disable --now khaymali-restart-$r.timer 2>/dev/null; rm -f $UNIT/khaymali-restart-$r.*; ok "disabled"; return; fi
  printf '[Service]\nType=oneshot\nExecStart=/bin/systemctl restart khaymali-%s\n' $r >$UNIT/khaymali-restart-$r.service
  printf '[Timer]\nOnCalendar=*-*-* %02d:00:00\n[Install]\nWantedBy=timers.target\n' "$h" >$UNIT/khaymali-restart-$r.timer
  systemctl daemon-reload; systemctl enable --now khaymali-restart-$r.timer && ok "restart daily at $h:00"
}
tune(){
  cat >/etc/sysctl.d/99-khaymali.conf <<'EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_slow_start_after_idle = 0
EOF
  modprobe tcp_bbr 2>/dev/null; sysctl --system >/dev/null 2>&1; ok "tuning applied: $(sysctl -n net.ipv4.tcp_congestion_control)"; }
tune_revert(){ rm -f /etc/sysctl.d/99-khaymali.conf; sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1; sysctl --system >/dev/null 2>&1; ok "tuning reverted"; }
backup(){ mkdir -p "$BK"; local f="$BK/khaymali-$(date +%Y%m%d-%H%M%S).tgz"; tar -czf "$f" -C / etc/khaymali 2>/dev/null && chmod 600 "$f" && ok "backup: $f (contains private keys!)"; }
restore(){ local f=${1:-}; [ -z "$f" ] && { ls -1 "$BK" 2>/dev/null; f=$(ask "File" "$(ls -1t $BK/*.tgz 2>/dev/null | head -1)"); }
  tar -xzf "$f" -C / && for r in $(roles); do apply_role $r; done; }
cleanup(){ journalctl --vacuum-size=100M >/dev/null 2>&1; ls -1t $BK/*.tgz 2>/dev/null | tail -n +6 | xargs -r rm -f; ok "logs vacuumed to 100M, old backups pruned"; df -h / | tail -1; }
update(){
  local v; v=${KHAYMALI_VERSION:-$(ask "Version tag (latest ignores pre-releases)" latest)}
  KHAYMALI_NO_MENU=1 KHAYMALI_VERSION=$v bash <(curl -fsSL "https://raw.githubusercontent.com/$REPO/main/install.sh") || { err "update failed (GitHub blocked? copy the binary with scp)"; return 1; }
  for r in $(roles); do systemctl restart khaymali-$r; done; ok "updated: $("$BIN" version)"
}
update_manager(){ curl -fsSL "https://raw.githubusercontent.com/$REPO/main/scripts/khaymali-manager" -o /tmp/km && bash -n /tmp/km && install -m755 /tmp/km /usr/local/bin/khaymali-manager && ok "manager updated"; }
logs(){ local r; r=$(roles | head -1); [ "$(roles | wc -l)" -gt 1 ] && r=$(ask "Role" "$r"); journalctl -u khaymali-$r -n 60 --no-pager -o cat; }
svc(){ local r; r=$(ask "Role" "$(roles | head -1)"); systemctl "$1" khaymali-$r && ok "$1 khaymali-$r"; }
uninstall(){ [ "$(ask 'Type YES to remove all khaymali services and config')" = YES ] || return
  backup; for r in exit entry bridge; do systemctl disable --now khaymali-$r 2>/dev/null; rm -f $UNIT/khaymali-$r.service; done
  rm -rf "$ETC"; systemctl daemon-reload; ok "removed (binary kept at $BIN)"; }

menu(){
  while true; do
    clear 2>/dev/null
    echo "${c_b}Khaymali manager $VERSION_MGR${c_0}  | $("$BIN" version 2>/dev/null) | roles: $(roles | xargs)"
    cat <<'EOF'
  1) Setup EXIT  (abroad)          9) Doctor: Direct or Bridge?
  2) Setup ENTRY (Iran)           10) Port forwards
  3) Setup BRIDGE                 11) Edit config (auto-rollback)
  4) Status                       12) Scheduled restart timer
  5) Logs                         13) Kernel tuning / BBR   13r) revert
  6) Restart service              15) Backup    15r) Restore
  7) Stop service                 16) Disk & log cleanup
  8) Manage keys / join code      17) Update binary   17m) Update manager
                                  99) Uninstall      0) Quit
EOF
    case $(ask "Choice") in
      1) setup_exit;; 2) setup_entry;; 3) setup_bridge;; 4) status;; 5) logs;;
      6) svc restart;; 7) svc stop;; 8) manage_keys;; 9) doctor;; 10) forwards;;
      11) edit_cfg;; 12) timers;; 13) tune;; 13r) tune_revert;; 14) warn "Telegram alerts: not implemented yet";;
      15) backup;; 15r) restore;; 16) cleanup;; 17) update;; 17m) update_manager;; 99) uninstall;;
      0|q) exit 0;; *) warn "unknown choice";;
    esac
    pause
  done
}

need_root
[ -x "$BIN" ] || { err "khaymali binary not found at $BIN"; exit 1; }
case "${1:-menu}" in
  menu) menu;;
  status) status;; doctor) shift; doctor "$@";; logs) logs;;
  update) update;; update-manager) update_manager;; backup) backup;; restore) shift; restore "${1:-}";;
  tune) tune;; tune-revert) tune_revert;; tune-status) sysctl net.ipv4.tcp_congestion_control net.core.default_qdisc;;
  cleanup) cleanup;; notify-test) warn "Telegram alerts: not implemented yet";;
  version) echo "khaymali-manager $VERSION_MGR";;
  *) echo "usage: khaymali-manager [menu|status|doctor IP PORT|logs|update|update-manager|backup|restore FILE|tune|tune-revert|tune-status|cleanup]"; exit 2;;
esac
