]

TABS = ["NODES", "CONNECTION TEST", "TUNNELS", "FORWARDED PORTS"]


def fmt_bytes(b: float) -> str:
    b = max(0.0, float(b))
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if b < 1024.0 or unit == "TB":
            return f"{b:.1f} {unit}" if unit != "B" else f"{int(b)} B"
        b /= 1024.0
    return f"{b:.1f} TB"


def fmt_rate(bps: float) -> str:
    bps = max(0.0, float(bps))
    if bps >= 1e9:
        return f"{bps / 1e9:.2f} Gb/s"
    if bps >= 1e6:
        return f"{bps / 1e6:.1f} Mb/s"
    if bps >= 1e3:
        return f"{bps / 1e3:.1f} kb/s"
    return f"{int(bps)} b/s"


def fmt_uptime(secs: float) -> str:
    s = max(0, int(secs))
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    m, sec = divmod(s, 60)
    if d > 0:
        return f"{d}d {h}h"
    if h > 0:
        return f"{h}h {m}m"
    if m > 0:
        return f"{m}m {sec}s"
    return f"{sec}s"


def parse_prometheus(text: str):
    scalars, exits = {}, {}
    for line in text.splitlines():
        m = re.match(r'^khaymali_exit_([a-z0-9_]+)\{addr="([^"]+)"\}\s+([0-9.\-]+)$', line)
        if m:
            exits.setdefault(m.group(2), {})[m.group(1)] = float(m.group(3))
            continue
        m = re.match(r'^khaymali_([a-z0-9_]+)\s+([0-9.\-]+)$', line)
        if m:
            scalars[m.group(1)] = float(m.group(2))
    return scalars, exits


def control_rpc(sock_path: str, payload: dict, timeout: float = 0.8):
    if not sock_path or not os.path.exists(sock_path):
        return None
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(sock_path)
        s.sendall((json.dumps(payload) + "\n").encode("utf-8"))
        chunks = []
        while True:
            buf = s.recv(65536)
            if not buf:
                break
            chunks.append(buf)
            if b"\n" in buf:
                break
        raw = b"".join(chunks).decode("utf-8", "replace").strip()
        return json.loads(raw) if raw else None
    except Exception:
        return None
    finally:
        try:
            s.close()
        except Exception:
            pass


def fetch_metrics(urls):
    for url in urls:
        if not url:
            continue
        try:
            with urllib.request.urlopen(url, timeout=0.6) as resp:
                return url, parse_prometheus(resp.read().decode("utf-8", "replace"))
        except Exception:
            continue
    return None, ({}, {})


class DataStore:
    def __init__(self, demo: bool = False, control_sock: str = "", metrics_url: str = ""):
        self.demo = demo
        self.control_sock = control_sock
        self.metrics_url = metrics_url
        self.hostname = socket.gethostname()
        self.tunnels = []
        self.forwards = []
        self.status = {}
        self.recovery = {}
        self.adapt = {}
        self.scalars = {}
        self.active_sock = None
        self.active_metrics = None
        self.prev_ts = None
        self.prev_up = 0.0
        self.prev_dn = 0.0
        self.tx_bps = 0.0
        self.rx_bps = 0.0
        self.peak_rx_bps = 0.0
        self.hist_tx = collections.deque([0.0] * 48, maxlen=48)
        self.hist_rx = collections.deque([0.0] * 48, maxlen=48)
        self.conn_test_log = []
        self._demo_rng = random.Random(42)
        self._demo_tick = 0
        if self.demo:
            self._init_demo()

    def _init_demo(self):
        for i in range(48):
            wave = 0.55 + 0.35 * math.sin(i * 0.22) + self._demo_rng.uniform(-0.08, 0.08)
            rx = max(8e6, min(102e6, wave * 90e6))
            tx = max(3e6, rx * self._demo_rng.uniform(0.25, 0.42))
            self.hist_tx.append(tx)
            self.hist_rx.append(rx)
        self.peak_rx_bps = 102.2e6

    def poll(self):
        if self.demo:
            self._poll_demo()
            return
        now = time.monotonic()

        sock_candidates = [self.control_sock] if self.control_sock else DEFAULT_SOCKS
        sock = next((p for p in sock_candidates if p and os.path.exists(p)), None)
        self.active_sock = sock

        if sock:
            st = control_rpc(sock, {"method": "status"})
            if st and st.get("ok"):
                self.status = st
            rec = control_rpc(sock, {"method": "recovery.status"})
            if rec and rec.get("ok"):
                self.recovery = rec
            ad = control_rpc(sock, {"method": "adapt.status"})
            if ad and ad.get("ok"):
                self.adapt = ad
            fw = control_rpc(sock, {"method": "forwards.list"})
            if fw and fw.get("ok"):
                self.forwards = fw.get("forwards", [])
            peers = control_rpc(sock, {"method": "peers.list"})
            peer_code = ""
            if peers and peers.get("peers"):
                peer_code = peers["peers"][0].get("check_code", "")
        else:
            peer_code = ""

        m_candidates = [self.metrics_url] if self.metrics_url else DEFAULT_METRICS
        m_url, (sc, ex_map) = fetch_metrics(m_candidates)
        self.active_metrics = m_url
        self.scalars = sc

        up_b = self.status.get("bytes_up", sc.get("bytes_up_total", 0.0))
        dn_b = self.status.get("bytes_down", sc.get("bytes_down_total", 0.0))
        if self.prev_ts is not None and now > self.prev_ts:
            dt = now - self.prev_ts
            self.tx_bps = max(0.0, (up_b - self.prev_up) * 8.0 / dt)
            self.rx_bps = max(0.0, (dn_b - self.prev_dn) * 8.0 / dt)
            self.peak_rx_bps = max(self.peak_rx_bps, self.rx_bps)
            self.hist_tx.append(self.tx_bps)
            self.hist_rx.append(self.rx_bps)
        self.prev_ts = now
        self.prev_up = up_b
        self.prev_dn = dn_b

        role = str(self.status.get("role", "entry")).upper()
        if role == "ENTRY":
            role_tag = "IRAN"
        elif role == "EXIT":
            role_tag = "EXIT"
        else:
            role_tag = role[:6]
        transport = str(self.status.get("transport", "tcp+mux"))
        uptime = self.status.get("uptime_secs", 0)
        carriers = int(self.status.get("mux_carriers", sc.get("mux_carriers_active", sc.get("links_ready", 0))))
        streams = int(self.status.get("streams_active", sc.get("streams_active", 0)))
        loss = float(self.recovery.get("loss_pct", sc.get("udp_loss_per_mille", 0.0) / 10.0))
        fw_summary = " ".join(
            f"{f.get('port')}/{f.get('proto')}" if f.get("proto") == "udp" else str(f.get("port"))
            for f in self.forwards[:4]
        ) or "1080/socks5"

        tunnels = []
        if ex_map:
            n_up = max(1, sum(1 for v in ex_map.values() if v.get("up", 0) >= 1))
            for addr, info in sorted(ex_map.items()):
                is_up = info.get("up", 0) >= 1
                host_part, _, port_part = addr.rpartition(":")
                tunnels.append({
                    "name": host_part or addr,
                    "addr": addr,
                    "port": port_part or "443",
                    "role": role_tag,
                    "transport": transport,
                    "up": is_up,
                    "state": f"up {fmt_uptime(uptime)}" if (is_up and uptime) else ("up" if is_up else "down"),
                    "carriers": carriers if is_up else 0,
                    "streams": streams if is_up else 0,
                    "rtt_ms": float(info.get("rtt_ms", 0.0)),
                    "jitter_ms": float(info.get("jitter_ms", 0.0)),
                    "loss_pct": loss,
                    "tx_bps": self.tx_bps / n_up if is_up else 0.0,
                    "rx_bps": self.rx_bps / n_up if is_up else 0.0,
                    "bytes_up": up_b,
                    "bytes_down": dn_b,
                    "uptime_secs": uptime,
                    "check_code": peer_code or "LIVE-NODE",
                    "forwards": fw_summary,
                })
        elif sc or self.status:
            tunnels.append({
                "name": "khaymali-local",
                "addr": self.active_metrics or self.active_sock or "127.0.0.1",
                "port": "443",
                "role": role_tag,
                "transport": transport,
                "up": True,
                "state": f"up {fmt_uptime(uptime)}" if uptime else "up",
                "carriers": carriers,
                "streams": streams,
                "rtt_ms": float(sc.get("nlp_link_rtt_ms", 0.0)),
                "jitter_ms": float(sc.get("intelligence_measured_jitter_tenths_ms", 0.0)) / 10.0,
                "loss_pct": loss,
                "tx_bps": self.tx_bps,
                "rx_bps": self.rx_bps,
                "bytes_up": up_b,
                "bytes_down": dn_b,
                "uptime_secs": uptime,
                "check_code": peer_code or "LIVE-NODE",
                "forwards": fw_summary,
            })
        self.tunnels = tunnels

    def _poll_demo(self):
        self._demo_tick += 1
        rx1 = max(20e6, min(105e6, 70.6e6 + self._demo_rng.uniform(-14e6, 16e6)))
        tx1 = max(8e6, min(45e6, 24.0e6 + self._demo_rng.uniform(-5e6, 6e6)))
        rx2 = max(2e6, 7.8e6 + self._demo_rng.uniform(-2e6, 2.5e6))
        tx2 = max(1e6, 2.6e6 + self._demo_rng.uniform(-0.8e6, 1.0e6))
        self.tx_bps = tx1 + tx2
        self.rx_bps = rx1 + rx2
        self.peak_rx_bps = max(self.peak_rx_bps, rx1)
        self.hist_tx.append(tx1)
        self.hist_rx.append(rx1)
        self.scalars = {
            "links_ready": 64, "streams_active": 57, "adapt_condition": 0,
