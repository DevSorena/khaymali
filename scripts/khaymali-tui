#!/usr/bin/env python3
"""Khaymali Tunnel Interactive TUI Dashboard (zero external dependencies, Python 3 curses).

Usage:
  khaymali-tui                                 # Auto-detect live control socket + metrics
  khaymali-tui --metrics http://127.0.0.1:9100/metrics
  khaymali-tui --control /run/khaymali/entry.sock
  khaymali-tui --demo                          # Interactive preview with animated live traffic
"""
import argparse
import collections
import curses
import datetime
import json
import math
import os
import random
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.request

DEFAULT_SOCKS = [
    os.environ.get("KHAYMALI_CONTROL", ""),
    "/run/khaymali/entry.sock",
    "/run/khaymali/exit.sock",
    "/run/khaymali/bridge.sock",
]
DEFAULT_METRICS = [
    os.environ.get("KHAYMALI_METRICS_URL", ""),
    "http://127.0.0.1:9109/metrics",
    "http://127.0.0.1:9111/metrics",
    "http://127.0.0.1:9100/metrics",
    "http://127.0.0.1:9090/metrics",
    "http://127.0.0.1:9110/metrics",
]

COND_NAMES = ["Normal", "Degraded", "Hostile", "Blackout", "Recovering"]
MODE_NAMES = ["Normal", "Watch", "Degraded", "Critical"]
NLP_INTENTS = [
    "healthy", "early_rst", "byte_freeze", "pmtu_drop",
    "throttle", "route_or_dns_fail", "unrelated",
]

SIDEBAR_ITEMS = [
    ("setup_iran", "Setup Iran"),
    ("setup_kharej", "Setup Kharej"),
